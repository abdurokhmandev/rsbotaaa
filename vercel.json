{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://botttttttt-production.up.railway.app/api/$1"
    },
    {
      "src": "/webappregister",
      "dest": "/marketing"
    },
    {
      "src": "/marketingadmin",
      "dest": "/admin.html"
    },
    {
      "src": "/",
      "dest": "/portfolio.html"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/admin-login",
      "dest": "/login.html"
    }
  ]
}
