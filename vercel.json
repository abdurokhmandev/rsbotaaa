{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://botttttttt-production.up.railway.app/api/$1"
    },
    {
      "src": "/webappregister",
      "dest": "/marketing.html"
    },
    {
      "src": "/marketingadmin",
      "dest": "/marketingadmin.html"
    },
    {
      "src": "/",
      "dest": "/portfolio.html"
    },
    {
      "src": "/cefrchi-admin",
      "dest": "https://web-production-69ee71.up.railway.app/admin.html"
    },
    {
      "src": "/cefrchi-login",
      "dest": "https://web-production-69ee71.up.railway.app/login.html"
    }
  ]
}
